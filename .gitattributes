# Normalize line endings across Windows/Linux. Default: git decides text vs binary.
* text=auto

# Unity YAML + metadata: always LF so Windows/Linux never churn
*.unity     text eol=lf linguist-language=yaml
*.prefab    text eol=lf linguist-language=yaml
*.asset     text eol=lf linguist-language=yaml
*.mat       text eol=lf linguist-language=yaml
*.anim      text eol=lf linguist-language=yaml
*.controller text eol=lf linguist-language=yaml
*.overrideController text eol=lf linguist-language=yaml
*.physicMaterial text eol=lf linguist-language=yaml
*.physicsMaterial2D text eol=lf linguist-language=yaml
*.mask      text eol=lf linguist-language=yaml
*.flare     text eol=lf linguist-language=yaml
*.lighting  text eol=lf linguist-language=yaml
*.playable  text eol=lf linguist-language=yaml
*.signal    text eol=lf linguist-language=yaml
*.spriteatlas text eol=lf linguist-language=yaml
*.preset    text eol=lf linguist-language=yaml
*.meta      text eol=lf linguist-language=yaml

# Code, shaders, config: LF
*.cs        text eol=lf diff=csharp
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.shader    text eol=lf
*.compute   text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.uss       text eol=lf
*.uxml      text eol=lf
*.sh        text eol=lf
ProjectSettings/*.asset text eol=lf
Packages/manifest.json text eol=lf
Packages/packages-lock.json text eol=lf

# Windows-only scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary: never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.ai        binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.bmp       binary
*.exr       binary
*.hdr       binary
*.ico       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.aif       binary
*.aiff      binary
*.mp4       binary
*.mov       binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.dll       binary
*.so        binary
*.a         binary
*.exe       binary
*.ttf       binary
*.otf       binary
*.zip       binary
*.7z        binary
*.unitypackage binary
